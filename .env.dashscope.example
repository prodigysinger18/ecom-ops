# Copy settings into .env; never commit credentials.
RAG_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_GENERATION_MODEL=qwen-plus
RAG_GENERATION_ENABLED=true
RAG_PROVIDER_TIMEOUT_SECONDS=15
RAG_TOTAL_TIMEOUT_SECONDS=45
RAG_TIMEOUT_SECONDS=20
RAG_MIN_SIMILARITY=0.3
# Calibrate similarity on a development set using real embeddings.
