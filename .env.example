DATABASE_URL=sqlite:///./ecom_ops.db
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_API_KEY=dev-admin-key
AGENT_API_KEY=dev-agent-key
# Customer JWT: separate random signing secret of at least 32 bytes; never put it in frontend.
# CUSTOMER_JWT_SECRET=
CUSTOMER_TOKEN_TTL_SECONDS=1800
DEMO_ENABLED=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# RAG: offline lexical-vector / extractive baseline; false restores legacy routing.
RAG_ENABLED=true
RAG_SHOP_ID=demo-shop
RAG_TIMEOUT_SECONDS=5
RAG_MIN_SIMILARITY=0.12
RAG_RERANK_ENABLED=false
RAG_SELF_RAG_ENABLED=false
AGENT_TOOL_TRANSPORT=mcp
MCP_CALL_TIMEOUT_SECONDS=15
# Optional embedding service: full HTTP endpoint accepting model/input, returning data/index/embedding.
# RAG_EMBEDDING_URL=https://your-provider.example/embeddings
# RAG_EMBEDDING_KEY=
# RAG_EMBEDDING_MODEL=your-embedding-model
